# Скопируй в .env и заполни. Без ключа AI-слой работает в режиме stub.
ANTHROPIC_API_KEY=
CRYPTO_NEWS_MODEL=claude-sonnet-4-6

# Источники через запятую: rss, investing, cryptopanic, mock
CRYPTO_NEWS_SOURCES=rss,investing,cryptopanic,mock

# CryptoPanic: бесплатный токен с https://cryptopanic.com/developers/api/
# Без токена источник cryptopanic тихо пропускается.
CRYPTOPANIC_TOKEN=

# Путь к БД (по умолчанию backend/data/crypto_news.db)
# CRYPTO_NEWS_DB=
